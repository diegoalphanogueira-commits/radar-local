{
  "manifest_version": 3,
  "name": "Radar Maps Collector",
  "version": "1.4.1",
  "description": "Radar Local V1 RC12: sessões de busca isoladas, geocodificação fresca por região, memória V2 segura e coleta resiliente.",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-v2.js"
  },
  "action": {
    "default_title": "Radar Maps Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
      "js": ["content-v2.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://radar.metodoflow360.com.br/*"],
      "css": ["radar-v1-priority-local.css"],
      "js": ["radar-bridge-v3.js", "radar-v1-search-memory-v2-local.js", "radar-v1-bootstrap-v2.js", "radar-v1-priority-local.js"],
      "run_at": "document_start"
    }
  ]
}
