{
  "manifest_version": 3,
  "name": "Radar Maps Collector",
  "version": "1.3.1",
  "description": "Radar Local V1 RC2: cobertura espacial, consistência geográfica, mapa visual e medição da qualidade da varredura.",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.br/maps/*",
    "https://radar.metodoflow360.com.br/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background-v1.js"
  },
  "action": {
    "default_title": "Radar Maps Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://radar.metodoflow360.com.br/*"],
      "js": ["radar-bridge.js", "radar-v1-bootstrap.js"],
      "run_at": "document_start"
    }
  ]
}
