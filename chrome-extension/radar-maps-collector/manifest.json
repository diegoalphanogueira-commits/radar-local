{
  "manifest_version": 3,
  "name": "Radar Maps Collector",
  "version": "1.4.2",
  "description": "Radar Local V1 RC13: Discovery Engine V3, cobertura controlável, sessões isoladas e captura resiliente do Google Maps.",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-v3.js"
  },
  "action": {
    "default_title": "Radar Maps Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
      "js": ["content-v3.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://radar.metodoflow360.com.br/*"],
      "css": ["radar-v1-priority-local.css", "radar-coverage-target.css"],
      "js": ["radar-bridge-v4.js", "radar-v1-bootstrap-v2.js", "radar-v1-priority-local.js"],
      "run_at": "document_start"
    }
  ]
}
