{
  "manifest_version": 3,
  "name": "Radar Maps Collector",
  "version": "1.2.1",
  "description": "Coleta negócios do Google Maps, executa buscas regionais completas e envia os dados ao Radar Local.",
  "permissions": ["activeTab", "tabs", "storage", "downloads", "scripting"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.br/maps/*",
    "https://radar.metodoflow360.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Radar Maps Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://radar.metodoflow360.com.br/*"],
      "js": ["radar-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
